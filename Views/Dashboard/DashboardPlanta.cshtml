<script>
        document.addEventListener("DOMContentLoaded", function () {
        // 1. Establecer rango por defecto en los inputs (Enero 1 al día de hoy)
        const anioActual = new Date().getFullYear();
        const hoy = new Date().toISOString().split('T')[0];

        document.getElementById('globalFechaInicio').value = `${anioActual}-01-01`;
        document.getElementById('globalFechaFin').value = hoy;

        // Coloca el año en tus etiquetas de interfaz
        const lblAnio = document.getElementById('lblAnioActual');
        if (lblAnio) lblAnio.textContent = anioActual;

        // 2. Carga inicial de todas las gráficas
        actualizarTodoElDashboard();

        // 3. Escuchar clic del botón Aplicar Filtro
        document.getElementById('btnAplicarFiltroGlobal').addEventListener('click', function() {
            actualizarTodoElDashboard();
        });

        // 4. Escuchar clic del botón Limpiar (Regresa al año actual por defecto)
        document.getElementById('btnLimpiarFiltroGlobal').addEventListener('click', function() {
            document.getElementById('globalFechaInicio').value = `${anioActual}-01-01`;
            document.getElementById('globalFechaFin').value = hoy;
            actualizarTodoElDashboard();
        });
    });

    function actualizarTodoElDashboard() {
        const inicio = document.getElementById('globalFechaInicio').value;
        const fin = document.getElementById('globalFechaFin').value;

        if ((inicio && !fin) || (!inicio && fin)) {
            alert("Por favor, selecciona un rango de fechas completo (Desde y Hasta).");
            return;
        }

        cargarGraficaTickets(inicio, fin);          // Creados vs Cerrados
        cargarGraficaEstadosAnual(inicio, fin);     // Distribución por Estado
        cargarTop3Categorias(inicio, fin);
        cargarGraficaTopAreas(inicio, fin);
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnFullscreen = document.getElementById('btnFullscreenDashboard');
        const contenedorLayout = document.getElementById('dashboardPrincipal');

        if (btnFullscreen && contenedorLayout) {
            btnFullscreen.addEventListener('click', function () {
                if (!document.fullscreenElement) {
                    contenedorLayout.requestFullscreen()
                        .then(() => {
                            btnFullscreen.innerHTML = '<i class="fas fa-compress me-1"></i> <span>Salir</span>';
                            btnFullscreen.className = "btn btn-outline-dark rounded-pill px-3 shadow-sm";
                        })
                        .catch(err => {
                            console.error(`Error de hardware al maximizar el Layout: ${err.message}`);
                        });
                } else {
                    document.exitFullscreen();
                }
            });

            document.addEventListener('fullscreenchange', function () {
                if (!document.fullscreenElement) {
                    const btnFullscreen = document.getElementById('btnFullscreenDashboard');
                    if (btnFullscreen) {
                        btnFullscreen.innerHTML = '<i class="fas fa-expand me-1"></i> <span>Pantalla Completa</span>';
                        btnFullscreen.className = "btn btn-dark rounded-pill px-3 shadow-sm";
                    }

                    setTimeout(() => {
                        window.dispatchEvent(new Event('resize'));

                        Object.keys(Chart.instances).forEach(function (id) {
                            if (Chart.instances[id]) {
                                Chart.instances[id].destroy();
                            }
                        });

                        chartAnualInstancia = null;
                        chartCumplimientoInstancia = null;
                        chartTecnicosInstancia = null;
