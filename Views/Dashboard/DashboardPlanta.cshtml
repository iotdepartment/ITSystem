<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

<script>
    let chartAnualInstancia = null;

    function cargarGraficaTickets(inicio = '', fin = '') {
        let url = `/Dashboard/ObtenerMetricasAnuales?inicio=${inicio}&fin=${fin}`;

        fetch(url)
            .then(response => response.json())
            .then(data => {
                const canvasElement = document.getElementById('chartTicketsAnual');
                if (!canvasElement) return;

                const ctx = canvasElement.getContext('2d');

                if (chartAnualInstancia !== null) {
                    chartAnualInstancia.data.datasets[0].data = data.creados;  
                    chartAnualInstancia.data.datasets[1].data = data.cerrados; 

                    chartAnualInstancia.update({
                        duration: 800,
                        easing: 'easeOutQuart' 
                    });
                    return; 
                }

                const graficoExistenteEnCanvas = Chart.getChart("chartTicketsAnual");
                if (graficoExistenteEnCanvas) {
                    graficoExistenteEnCanvas.destroy();
                }

                const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

                chartAnualInstancia = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: meses,
                        datasets: [
                            {
                                label: 'Tickets Generados',
                                data: data.creados,
                                backgroundColor: 'rgba(13, 110, 253, 0.75)',
                                borderColor: 'rgb(13, 110, 253)',
                                borderWidth: 1,
                                borderRadius: 6,
                                barPercentage: 0.8,
                                categoryPercentage: 0.7
                            },
                            {
                                label: 'Tickets Cerrados',
                                data: data.cerrados,
                                backgroundColor: 'rgba(25, 135, 84, 0.75)',
                                borderColor: 'rgb(25, 135, 84)',
                                borderWidth: 1,
                                borderRadius: 6,
                                barPercentage: 0.8,
                                categoryPercentage: 0.7
                            }
                        ]
                    },
                    plugins: [ChartDataLabels],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 1000 
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    boxWidth: 10,
                                    font: { weight: 'bold', family: 'system-ui', size: 13 }
                                }
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                padding: 12,
                                titleFont: { family: 'system-ui', weight: 'bold', size: 13 },
                                bodyFont: { family: 'system-ui', weight: 'bold', size: 13 }
                            },
                            datalabels: {
                                anchor: 'end',
                                align: 'top',
                                offset: 3,
                                font: {
                                    weight: 'bold', 
                                    size: 15,      
                                    family: 'system-ui'
                                },
                                formatter: value => value > 0 ? value : '',
                                color: context => context.dataset.borderColor
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'system-ui', weight: 'bold', size: 13 } }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1,
                                    precision: 0,
                                    font: { family: 'system-ui', weight: 'bold', size: 12 } 
                                },
                                grace: '15%' 
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('Error al cargar la gráfica del dashboard:', error));
    }
</script>


<script>
    let miGraficoEstados = null;

    document.addEventListener("DOMContentLoaded", function () {
        cargarGraficaEstadosAnual();
    });

    function cargarGraficaEstadosAnual(inicio = '', fin = '') {
        let url = '/Dashboard/ObtenerVolumenPorEstado';
        if (inicio.trim() !== '' && fin.trim() !== '') {
            url += `?inicio=${inicio}&fin=${fin}`;
        }

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error("Error al obtener volumen de estados");
                return response.json();
            })
            .then(data => {
                if (miGraficoEstados !== null) {
                    miGraficoEstados.data.datasets[0].data = data.totales;
                    miGraficoEstados.update({
                        duration: 800,
                        easing: 'easeOutQuart'
                    });
                    return;
                }

                const graficoExistenteEnCanvas = Chart.getChart("chartEstadosTickets");
                if (graficoExistenteEnCanvas) {
                    graficoExistenteEnCanvas.destroy();
                }

                renderizarGraficaEstadosCanvas(data.estados, data.totales);
            })
            .catch(error => console.error('Error al cargar gráfica de estados:', error));
    }

    function renderizarGraficaEstadosCanvas(labels, valores) {
        const ctx = document.getElementById('chartEstadosTickets').getContext('2d');
        if (!ctx) return;

        const coloresFondo = [
            'rgba(220, 53, 69, 0.75)',
            'rgba(255, 193, 7, 0.75)',
            'rgba(13, 202, 240, 0.75)',
            'rgba(25, 135, 84, 0.75)'
        ];

        const coloresBorde = [
            'rgb(220, 53, 69)',
            'rgb(255, 193, 7)',
            'rgb(13, 202, 240)',
            'rgb(25, 135, 84)'
        ];

        miGraficoEstados = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    data: valores,
                    backgroundColor: coloresFondo,
                    borderColor: coloresBorde,
                    borderWidth: 1,
                    borderRadius: 6,
                    barPercentage: 0.5
                }]
            },
            plugins: [ChartDataLabels],
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1000
                },
                plugins: {
                    legend: { display: false },

                    tooltip: {
                        padding: 12,
                        titleFont: { family: 'system-ui', weight: 'bold', size: 13 },
                        bodyFont: { family: 'system-ui', weight: 'bold', size: 13 }
                    },

                    datalabels: {
                        anchor: 'end',
                        align: 'top',
                        offset: 3,
                        font: {
                            weight: 'bold',
                            size: 15,
                            family: 'system-ui'
                        },
                        formatter: function(value) {
                            return value > 0 ? value : '';
                        },
                        color: '#000000'
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'system-ui', weight: 'bold', size: 13 } }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, precision: 0, font: { family: 'system-ui', weight: 'bold', size: 12 } },
                        grace: '15%'
                    }
                }
            }
        });
    }
</script>


<script>
    let instanciasChartsTop3 = [null, null, null];

    function cargarTop3Categorias(inicio = '', fin = '') {
        let url = '/Dashboard/ObtenerTopCategoriasYSubcategorias';
        if (inicio.trim() !== '' && fin.trim() !== '') {
            url += `?inicio=${inicio}&fin=${fin}`;
        }

        fetch(url)
            .then(response => response.json())
            .then(data => {
                for (let i = 0; i < 3; i++) {
                    const numTarjeta = i + 1;
                    const txtTitulo = document.getElementById(`txtTop${numTarjeta}Categoria`);
                    const badgeTotal = document.getElementById(`badgeTop${numTarjeta}Total`);
                    const canvasId = `chartTop${numTarjeta}Subcategorias`;
                    const canvasElement = document.getElementById(canvasId);

                    if (!data[i] || !canvasElement) {
                        if (txtTitulo) txtTitulo.textContent = "Sin Datos";
                        if (badgeTotal) badgeTotal.textContent = "0";
                        if (instanciasChartsTop3[i] !== null) {
                            instanciasChartsTop3[i].destroy();
                            instanciasChartsTop3[i] = null;
                        }
                        continue;
                    }

                    txtTitulo.textContent = data[i].categoria;
                    if (badgeTotal) {
                        badgeTotal.textContent = data[i].totalCategoria;
                    }

                    const ctx = canvasElement.getContext('2d');

                    const graficoExistente = Chart.getChart(canvasId);
                    if (graficoExistente) {
                        graficoExistente.destroy();
                    }

                    if (instanciasChartsTop3[i] !== null) {
                        try { instanciasChartsTop3[i].destroy(); } catch(e) {}
                        instanciasChartsTop3[i] = null;
                    }

                    const coloresPaleta = [
                        { fondo: 'rgba(220, 53, 69, 0.75)', borde: 'rgb(220, 53, 69)' },   
                        { fondo: 'rgba(255, 193, 7, 0.75)', borde: 'rgb(255, 193, 7)' },   
                        { fondo: 'rgba(13, 202, 240, 0.75)', borde: 'rgb(13, 202, 240)' }  
                    ];

                    // 4. Inicializar la nueva gráfica de barras horizontales compactas
                    instanciasChartsTop3[i] = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: data[i].subcategorias, 
                            datasets: [{
                                data: data[i].totales, 
                                backgroundColor: coloresPaleta[i].fondo,
                                borderColor: coloresPaleta[i].borde,
                                borderWidth: 1,
                                borderRadius: 4,
                                barPercentage: 0.6
                            }]
                        },
                        plugins: [ChartDataLabels],
                        options: {
                            indexAxis: 'y', 
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                               
                                tooltip: {
                                    padding: 10,
                                    titleFont: { family: 'system-ui', weight: 'bold', size: 12 },
                                    bodyFont: { family: 'system-ui', weight: 'bold', size: 12 }
                                },
                                
                                datalabels: {
                                    anchor: 'end',
                                    align: 'right',
                                    offset: 5,
                                    font: {
                                        weight: 'bold', 
                                        size: 14,      
                                        family: 'system-ui'
                                    },
                                    formatter: val => val > 0 ? val : '', 
                                    color: '#000000'
                                }
                            },
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: { stepSize: 1, precision: 0, display: false }, 
                                    grid: { display: false },
                                    border: { display: false },
                                    grace: '20%' 
                                },
                                y: {
                                    grid: { display: false },
                                    ticks: {
                                        font: { family: 'system-ui', size: 13, weight: 'bold' }
                                    }
                                }
                            }
                        }
                    });
                }
            })
            .catch(error => console.error('Error al cargar el Top 3 de Servicios:', error));
    }
</script>


