


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container-fluid">
    <div class="card mb-4 p-3 border Charts-style-glass d-flex flex-row align-items-center justify-content-between">
        <h2 class="m-0 text-start fw-bold">Graficas de Rendimiento de Personal</h2>
