        </button>
    </div>

    <!-- FILTRO DE FECHAS GLOBAL PARA EL DASHBOARD (AHORA FLOTANTE STICKY) -->
    <div class="row mb-4" style="position: sticky; top: 0; z-index: 1020;">
        <div class="col-12">
            <div class="card Charts-style-glass shadow border-0">
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
