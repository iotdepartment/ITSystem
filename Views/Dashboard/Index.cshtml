<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

<script>
    let chartCumplimientoInstancia = null;

    function cargarGraficaCumplimiento(inicio = '', fin = '') {
        let url = `/Dashboard/ObtenerPorcentajeCumplimiento?inicio=${inicio}&fin=${fin}`;

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error("Error al obtener métricas de cumplimiento");
                return response.json();
            })
            .then(data => {
                // 1. **MÁS GRANDE Y NEGRITAS**: Actualizar el porcentaje central inferior usando clases de impacto de Bootstrap
                const txtPorcentaje = document.getElementById('txtPorcentajeGranTotal');
                if (txtPorcentaje) {
                    txtPorcentaje.textContent = `${data.porcentajeCumplimiento}%`;
                    // Forzamos clases de tipografía grande y robusta
                    txtPorcentaje.className = "display-5 fw-extrabold text-dark mb-0";
                }

                const ctx = document.getElementById('chartCumplimiento').getContext('2d');
                if (!ctx) return;

                if (chartCumplimientoInstancia !== null) {
                    chartCumplimientoInstancia.data.datasets[0].data = [data.resueltos, data.pendientes];
                    chartCumplimientoInstancia.options.plugins.tooltip.callbacks.label = function(context) {
                        const valor = context.raw;
                        const total = data.total;
                        const pct = total > 0 ? ((valor / total) * 100).toFixed(1) : 0;
                        return ` ${context.label}: ${valor} tickets (${pct}%)`;
                    };

                    chartCumplimientoInstancia.update({
                        duration: 800,
                        easing: 'easeOutQuart'
                    });

                    return;
                }

                chartCumplimientoInstancia = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Resueltos', 'Pendientes / Otros'],
                        datasets: [{
                            data: [data.resueltos, data.pendientes],
                            backgroundColor: [
                                'rgba(25, 135, 84, 0.85)',
                                'rgba(220, 53, 69, 0.15)'
                            ],
                            borderColor: [
                                'rgb(25, 135, 84)',
                                'rgba(220, 53, 69, 0.4)'
                            ],
                            borderWidth: 1,
                            cutout: '70%' 
                        }]
                    },
                    plugins: [ChartDataLabels],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 1000,
                            animateRotate: true,
                            animateScale: false
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    boxWidth: 9,
                                    font: {
                                        family: 'system-ui',
                                        size: 13,
                                        weight: 'bold'
                                    }
                                }
                            },
                            tooltip: {
                                padding: 12,
                                titleFont: { family: 'system-ui', weight: 'bold', size: 13 },
                                bodyFont: { family: 'system-ui', weight: 'bold', size: 13 },
                                callbacks: {
                                    label: function(context) {
                                        const valor = context.raw;
                                        const total = data.total;
                                        const pct = total > 0 ? ((valor / total) * 100).toFixed(1) : 0;
                                        return ` ${context.label}: ${valor} tickets (${pct}%)`;
                                    }
                                }
                            },
                            datalabels: {
                                anchor: 'center',
                                align: 'center',
                                font: {
                                    weight: 'bold', 
                                    size: 16,       
                                    family: 'system-ui'
                                },
                                formatter: function(value) {
                                    return value > 0 ? value : '';
                                },
                                color: function(context) {
                                    return context.dataIndex === 0 ? '#ffffff' : 'rgb(220, 53, 69)';
                                }
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('Error al cargar gráfica de cumplimiento filtrada:', error));
    }
</script>



<script>
    let chartTecnicosInstancia = null;

    document.addEventListener("DOMContentLoaded", function () {
        const lblAnio = document.getElementById('lblAnioActual');
        if (lblAnio) lblAnio.textContent = new Date().getFullYear();

        cargarGraficaPorTecnico();
    });

    function cargarGraficaPorTecnico(inicio = '', fin = '') {
        let url = `/Dashboard/ObtenerTicketsPorTecnico?inicio=${inicio}&fin=${fin}`;

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error("Error al obtener carga detallada por técnico");
                return response.json();
            })
            .then(data => {
                const canvasElement = document.getElementById('chartTicketsPorTecnico');
                if (!canvasElement) return;

                const ctx = canvasElement.getContext('2d');

                const graficoExistenteEnCanvas = Chart.getChart("chartTicketsPorTecnico");
                if (graficoExistenteEnCanvas) {
                    graficoExistenteEnCanvas.destroy();
                }

                if (chartTecnicosInstancia !== null) {
                    try { chartTecnicosInstancia.destroy(); } catch(e) {}
                    chartTecnicosInstancia = null;
                }

                chartTecnicosInstancia = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.tecnicos,
                        datasets: [
                            {
                                label: 'Tickets Asignados (Activos)',
                                data: data.activos,
                                backgroundColor: 'rgba(0, 191, 165, 0.75)',
                                borderColor: 'rgb(0, 150, 136)',
                                borderWidth: 1,
                                borderRadius: 4,
                                barPercentage: 0.8,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Tickets Cerrados (Histórico)',
                                data: data.cerrados,
                                backgroundColor: 'rgba(25, 135, 84, 0.75)',
                                borderColor: 'rgb(25, 135, 84)',
                                borderWidth: 1,
                                borderRadius: 4,
                                barPercentage: 0.8,
                                categoryPercentage: 0.6
                            }
                        ]
                    },
                    plugins: [ChartDataLabels],
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    boxWidth: 10,
                                    font: { family: 'system-ui', weight: 'bold', size: 12 }
                                }
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                padding: 12,
                                titleFont: { family: 'system-ui', weight: 'bold', size: 13 },
                                bodyFont: { family: 'system-ui', weight: 'bold', size: 13 }
                            },

                            datalabels: {
                                anchor: 'end',
                                align: 'right',
                                offset: 5, 
                                font: {
                                    weight: 'bold', 
                                    size: 14,       
                                    family: 'system-ui'
                                },
                                formatter: function(value) {
                                    return value > 0 ? value : '';
                                },
                                color: function(context) {
                                    return context.dataset.borderColor;
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1,
                                    precision: 0,
                                    font: { family: 'system-ui', weight: 'bold', size: 12 } 
                                },
                                title: {
                                    display: true,
                                    text: 'Cantidad de Tickets',
                                    font: { weight: 'bold', family: 'system-ui', size: 13 } 
                                },
                                grace: '12%' 
                            },
                            y: {
                                grid: { display: false },
                                ticks: {
                                    font: { family: 'system-ui', weight: 'bold', size: 12 }
                                }
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('Error al cargar gráfica comparativa por técnico:', error));
    }
</script>



<script>
    let chartTiemposInstancia = null;

    function cargarGraficaTiempos(inicio = '', fin = '') {
        let url = '/Dashboard/ObtenerTiemposPromedio';
        if (inicio.trim() !== '' && fin.trim() !== '') {
            url += `?inicio=${inicio}&fin=${fin}`;
        }

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error("Error al obtener tiempos promedio");
                return response.json();
            })
            .then(data => {
                const ctx = document.getElementById('chartTiemposRespuesta').getContext('2d');
                if (!ctx) return;

                if (chartTiemposInstancia !== null) {
                    chartTiemposInstancia.data.datasets[0].data = data.atencion;
                    chartTiemposInstancia.data.datasets[1].data = data.solucion;

                    chartTiemposInstancia.update({
                        duration: 800,
                        easing: 'easeOutQuart'
                    });
                    return;
                }

                const graficoExistenteEnCanvas = Chart.getChart("chartTiemposRespuesta");
                if (graficoExistenteEnCanvas) {
                    graficoExistenteEnCanvas.destroy();
                }

                const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

                chartTiemposInstancia = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: meses,
                        datasets: [
                            {
                                label: 'Tiempo de Primera Atención (Minutos)',
                                data: data.atencion,
                                borderColor: 'rgb(255, 193, 7)',
                                backgroundColor: 'rgba(255, 193, 7, 0.1)',
                                borderWidth: 3,
                                tension: 0.3,
                                fill: true,
                                yAxisID: 'yAtencion'
                            },
                            {
                                label: 'Tiempo de Cierre/Solución (Minutos)',
                                data: data.solucion,
                                borderColor: 'rgb(13, 202, 240)',
                                backgroundColor: 'rgba(13, 202, 240, 0.1)',
                                borderWidth: 3,
                                tension: 0.3,
                                fill: true,
                                yAxisID: 'ySolucion'
                            }
                        ]
                    },
                    plugins: [ChartDataLabels],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 1000 },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { usePointStyle: true, font: { family: 'system-ui', weight: 'bold', size: 13 } }
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                padding: 12,
                                titleFont: { family: 'system-ui', weight: 'bold', size: 13 },
                                bodyFont: { family: 'system-ui', weight: 'bold', size: 13 },
                                callbacks: {
                                    label: function(context) {
                                        return ` ${context.dataset.label.split(' (')[0]}: ${context.raw} min`;
                                    }
                                }
                            },
                            datalabels: {
                                anchor: 'end',
                                align: 'top',
                                offset: 5,
                                font: {
                                    weight: 'bold',
                                    size: 14,
                                    family: 'system-ui'
                                },
                                formatter: function(value) {
                                    if (value === 0) return '';
                                    return value + ' min';
                                },
                                color: '#000000'
                            }
                        },
                        scales: {
                            yAtencion: {
                                type: 'linear',
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Minutos (Atención)',
                                    font: { weight: 'bold', family: 'system-ui', size: 13 }
                                },
                                beginAtZero: true,
                                grid: { drawOnChartArea: true },
                                ticks: { font: { family: 'system-ui', weight: 'bold', size: 12 } },
                                grace: '18%'
                            },
                            ySolucion: {
                                type: 'linear',
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Minutos (Solución)',
                                    font: { weight: 'bold', family: 'system-ui', size: 13 }
                                },
                                beginAtZero: true,
                                grid: { drawOnChartArea: false },
                                ticks: { font: { family: 'system-ui', weight: 'bold', size: 12 } },
                                grace: '18%'
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'system-ui', weight: 'bold', size: 13 } }
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('Error al cargar gráfica de tiempos en minutos:', error));
    }
</script>



<script>
